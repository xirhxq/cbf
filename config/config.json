          "pow": 1
        }
      },
      "cvt-yaw": {
        "name": "cvtYawCBF",
        "on": true,
        "k_yaw": 1.0,
        "alpha": {
          "coe": 1.0,
          "pow": 1
        }
      },
      "target-yaw": {
        "name": "yawCBF",
        "on": false,
        "kp": 1.0,
        "alpha": {
          "coe": 1.0,
          "pow": 1
        }
      }
    },
    "without-slack": {
      "//method": [
        "all",
        "min"
      ],
      "method": "all",
      "energy": {
        "name": "energyCBF",
        "on": false,
        "//energy-value": [
          "self",
          "neighbour-min"
        ],
        "energy-value": "neighbour-min",
        "normalize": {
          "on": false,
          "max": 100.0
        },
        "k": 12.0,
        "alpha": {
          "coe": 0.1,
          "pow": 1
        }
      },
      "safety": {
        "name": "safetyCBF",
        "on": true,
        "//mode": [
          "minimum",
          "pairwise"
        ],
        "mode": "pairwise",
        "safe-distance": 10.0,
        "k": 1.0,
        "consider-uncertainty": true,
        "alpha": {
          "coe": 0.1,
          "pow": 1
        }
      },
      "comm-fixed": {
        "name": "commFixedCBF",
        "on": true,
        "mode": "scissor",
        "max-range": 850.0,
        "k": 1.0,
        "min-neighbour-id-offset": -2,
        "max-neighbour-id-offset": 0,
        "compensate-velocity": true,
        "consider-uncertainty": true,
        "alpha": {
          "coe": 0.1,
          "pow": -1,
          "sat": 4.0
        }
      },
      "comm-auto": {
        "name": "commAutoCBF",
        "on": false,
        "max-range": 800,
        "max-consider-range": 1200,
        "k": 1.0,
        "alpha": {
          "coe": 0.1,
          "pow": 1
        }
      },
      "route1": {
        "on": true,
        "squad-first": 0,
        "joint-resolve": true
      }
    }
  },
  "execute": {
    "//execution-mode": [
      "distributed",
      "centralized"
    ],
    "execution-mode": "distributed",
    "time-total": 500,
    "time-step": 0.5,
    "check-constraint-violation": false
